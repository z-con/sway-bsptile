# sway config -- built to feel like bsptile (the GNOME tiling extension at
# github.com/z-con/bsptile): dynamic BSP-style auto-tiling, 12px gaps, a thin
# accent-colored focus border, a translucent top bar, and rounded/blurred
# popups via SwayFX. See ~/projects/sway-bsptile/README.md for what needs
# `install.sh` (SwayFX/waybar/wofi/autotiling) before this fully applies.

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term ghostty
set $menu wofi --show drun

### Output
# Fill in real output names once you know them (swaymsg -t get_outputs).
# Sway workspaces are natively per-output, so assigning workspaces to
# specific monitors here gets you bsptile's per-monitor virtual-workspace
# feature for free, no simulation needed:
#   workspace 1 output eDP-1
#   workspace 2 output DP-1
output * bg #1c1c20 solid_color
# Adopt and keep syncing GNOME's current wallpaper (picture-uri via
# gsettings/dconf); watches for live changes too, see scripts/sync-wallpaper.sh
exec_always ~/.config/sway/scripts/sync-wallpaper.sh watch
# 1:1 pixel scaling on the laptop panel (native 2160x1350) instead of sway's
# default 2.0 HiDPI guess.
output eDP-1 scale 1

### Autostart
# killall first -- exec_always reruns on every `sway reload`, and waybar
# doesn't enforce single-instance on its own, so without this each reload
# stacks another bar on top of the last.
exec_always killall -q waybar; exec waybar
# mako notification daemon (bsptile-equivalent for notification popups). No
# killall needed here -- it's a single-instance DBus service, so a second
# `mako` from a config reload just fails to grab the name and exits quietly.
exec_always mako
# swayidle: lock after 15min idle, then suspend. before-sleep also locks, as
# a safety net for suspends triggered outside the idle timer (e.g. lid
# close), since sway itself does no idle/power management on its own.
# killall guard for the same reason as waybar above -- exec_always reruns on
# reload and swayidle has no single-instance guard of its own.
exec_always killall -q swayidle; exec swayidle -w \
    timeout 900 'swaylock -f' \
    timeout 900 'systemctl suspend' \
    before-sleep 'swaylock -f'
# feed clipboard history into cliphist (text + images separately, per
# cliphist's own recommendation) -- plain `exec`, not `exec_always`, since
# these are long-running watchers with no single-instance guard of their
# own; re-execing on every reload would stack duplicate watchers.
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
# bsptile-style dynamic BSP/dwindle auto-tiling: picks split direction from
# each container's aspect ratio instead of you toggling splith/splitv by hand
exec autotiling -w 1

### Input
# bsptile's focus-mode=mouse (focus-follows-cursor)
focus_follows_mouse yes
mouse_warping output

### Look and feel -- gaps
# bsptile ships equal 12px gaps everywhere. Sway's inner gap alone already
# produces the full 12px between adjacent windows AND on its own at the
# screen edge (it's not halved at edges) -- outer is purely additive on top
# of that at the edges, so outer must be 0 to keep edges equal to the
# between-window gaps rather than thicker.
gaps inner 12
gaps outer 0

### Look and feel -- borders
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Thin accent-colored focus border (bsptile: GNOME accent color ring around
# the focused window only). Same purple used for JankyBorders in bsptile-mac
# for a consistent accent across machines.
#                       border   backgr.  text     indicator child_border
client.focused          #9d4edd #9d4edd  #ffffff  #9d4edd   #9d4edd
client.focused_inactive #444444 #333333  #cccccc  #444444   #444444
client.unfocused        #333333 #222222  #888888  #333333   #333333
client.urgent           #d64541 #d64541  #ffffff  #d64541   #d64541

### Look and feel -- SwayFX effects (no-ops on vanilla sway)
# bsptile clips every window to a fixed 12px corner radius via a shader
# effect, and blurs+tints shell popup menus (Quick Settings, calendar) for
# a translucent look. These two lines are the direct equivalents:
corner_radius 12
shadows disable
blur enable
blur_passes 3
blur_radius 4

# Subtle ease-out-cubic fade + slide/resize animation -- applies to
# workspace switches, window open/close, and windows sliding/resizing
# smoothly when a sibling opens/closes/moves (one knob controls all three,
# SwayFX doesn't split them out). 0 = off.
animation_duration_ms 150

# Blur/round the launcher (wofi, our Activities-Overview/Spotlight
# equivalent) like bsptile's blurred popup menus; leave the bar alone here
# since bsptile's real top panel is a flat 0.6-opacity tint, not blurred --
# that translucency is set in waybar's own CSS instead.
layer_effects "wofi" {
    blur enable
    corner_radius 12
    shadows disable
}

floating_modifier $mod normal

### Key bindings -- basics
bindsym $mod+Return exec $term
bindsym $mod+Ctrl+Return exec $term --working-directory=$HOME/Claude -e claude
# bsptile: Super+W closes focused window
bindsym $mod+w kill
# bsptile: Super+Space = Activities/Spotlight
bindsym $mod+space exec $menu
# bsptile: Super+T pulls a window into/out of tiling
bindsym $mod+t floating toggle
# clipboard history picker (same action as clicking the clipboard icon in
# waybar) -- Super+V was already taken by splitv, so this lives on Ctrl+V.
# After copying the picked entry, synthesize Ctrl+V with wtype so it pastes
# straight into whatever window has focus instead of just sitting on the
# clipboard waiting for a manual paste.
bindsym $mod+Ctrl+v exec cliphist list | wofi --dmenu | cliphist decode | wl-copy && sleep 0.1 && wtype -M ctrl -P v -p v -m ctrl
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

### Moving around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces (native per-monitor already -- see Output section above)
# bsptile: three-finger swipe to the next/previous workspace, spawning a
# fresh empty one on-demand when swiping past the last existing workspace
# (see ~/.local/share/sway-scripts/workspace-cycle.sh for the "spawn if
# missing" logic -- swipe left advances, swipe right goes back, matching
# natural/trackpad scroll direction).
bindgesture swipe:3:right exec ~/.local/share/sway-scripts/workspace-cycle.sh next
bindgesture swipe:3:left exec ~/.local/share/sway-scripts/workspace-cycle.sh prev
# macOS exposé stand-in: not spatial (sway/SwayFX has no thumbnail-grid
# overview), but same job -- swipe up, see every open window, pick one.
bindgesture swipe:3:up exec ~/.local/share/sway-scripts/window-switcher.sh

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

### Layout
# autotiling owns splith/splitv day-to-day; these stay available to override it.
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+Shift+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

### Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### Resizing
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Utilities
# wpctl (WirePlumber), not pactl -- this box has pipewire/wireplumber but
# never had pulseaudio-utils installed, so pactl doesn't exist and these
# silently did nothing.
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym Print exec GRIM_DEFAULT_DIR=$HOME/Pictures/Screenshots grim

# Native sway bar disabled -- waybar (started above) plays the top-panel role.

include /etc/sway/config.d/*

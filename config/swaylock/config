# swaylock -- matches the rest of the sway-bsptile theme (purple accent,
# dark translucent, Ubuntu Sans). Background image is a pre-blurred,
# theme-tinted copy of the live wallpaper, regenerated by
# scripts/sync-wallpaper.sh whenever the wallpaper changes.
image=~/.cache/sway-bsptile/lock-bg.png
scaling=fill

font=Ubuntu Sans
font-size=24
indicator-idle-visible
show-failed-attempts

indicator-radius=90
indicator-thickness=7
line-uses-ring

ring-color=9d4edd
inside-color=1c1c20cc
text-color=e8e8e8ff
separator-color=00000000

ring-ver-color=9d4edd
inside-ver-color=1c1c20cc
text-ver-color=e8e8e8ff

ring-wrong-color=d64541
inside-wrong-color=1c1c20cc
text-wrong-color=ffffffff

ring-caps-lock-color=e5c07b
inside-caps-lock-color=1c1c20cc
text-caps-lock-color=e8e8e8ff

key-hl-color=9d4edd
bs-hl-color=d64541
